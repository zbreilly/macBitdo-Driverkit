#!/bin/zsh
set -eu
# Distribution allows only CurrentUserHome: scripts must never run as root.
if (( $(id -u) == 0 )); then
    print -u2 'Install ReceiverBridge for the current user, without sudo.'; exit 1
fi
/bin/launchctl bootout "gui/$(id -u)/com.zbreilly.ReceiverBridge.agent" 2>/dev/null || true
for bridge_pid in $(/usr/bin/pgrep -u "$(id -u)" -x ReceiverBridge || true); do
    /bin/kill -TERM "$bridge_pid" 2>/dev/null || true
done
for attempt in {1..30}; do
    if ! /usr/bin/pgrep -u "$(id -u)" -x ReceiverBridge >/dev/null; then exit 0; fi
    /bin/sleep .1
done
print -u2 'Stop the previous bridge in Xcode or Terminal and retry installation.'
exit 1
